{
    "antigravity.autoOpenFiles": true,
    "antigravity.autoRecover": true,
    "chat.agent.sandbox.enabled": "off",
    "task.allowAutomaticTasks": "off",
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:uv"
        }
    ],
    "markdown.styles": [
        ".vscode/doku-minimap.css"
    ],
    "chat.mcp.serverSampling": {
        "1_Git-Labor (mestuermer-svg/first)/.vscode/mcp.json: geminiDocs": {
            "allowedModels": [
                "copilot/auto",
                "copilotcli/auto",
                "agent-host-copilotcli:auto",
                "agent-host-copilotcli:Google Agent/claude-opus-5-5",
                "agent-host-copilotcli:Google Agent/claude-sonnet-5-5",
                "agent-host-copilotcli:Google Agent/gemini-3.8-flash",
                "agent-host-copilotcli:google-acp/gemini-3.8-flash",
                "agent-host-copilotcli:Google Agent/gemini-4-argon",
                "agent-host-copilotcli:google-acp/gemini-4-argon",
                "agent-host-copilotcli:Google Agent/gpt-oss-120b-medium"
            ]
        },
        "1_Git-Labor (mestuermer-svg/first)/.mcp.json: nvidia-app": {
            "allowedModels": [
                "copilot/auto",
                "copilotcli/auto"
            ]
        }
    },
    "git.autofetch": true
}
