{
    "antigravityCopilot.server.autoStart": true,
    "antigravityCopilot.server.enabled": true,
    "antigravity.autoOpenFiles": true,
    "antigravity.autoRecover": true,
    "antigravityCopilot.rateLimit.cooldownMs": 15000,
    "chat.agent.sandbox.enabled": "off",
    "task.allowAutomaticTasks": "on",
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "markdown.styles": [
        ".vscode/doku-minimap.css"
    ]
}
